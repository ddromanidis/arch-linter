# Anchored to the repository root, all of them. An unanchored `archlint` matches any path
# component with that name — including the cmd/archlint/ directory, which git then ignored
# silently, so the main command was absent from every clone while building fine here.
/bin/
/.task/
/coverage.out
/archlint
/archlint-vet
/custom-gcl
/.archlint-baseline.yaml
.DS_Store
